{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["labwc/workspaces", "labwc/window"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "battery", "tray"],
  "clock": { "format": "{:%a %d %b %H:%M}" },
  "cpu": { "format": "CPU {usage}%" },
  "memory": { "format": "MEM {}%" },
  "network": { "format-disconnected": "NET off", "format": "NET {essid}" },
  "pulseaudio": { "format": "VOL {volume}%" },
  "battery": { "format": "BAT {capacity}%" }
}
